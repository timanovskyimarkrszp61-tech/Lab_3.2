\pard\plain\ql double solve_newton(double a, double b, double x0, double eps, unsigned long max_iter,\par
\pard\plain\ql                     unsigned long *out_iters, int *out_status)\par
\pard\plain\ql \{\par
\pard\plain\ql     double x = x0;\par
\pard\plain\ql     double x_next = x0;\par
\pard\plain\ql     unsigned long iter = 0;\par
\pard\plain\ql     int run_to_end = 0;\par
\pard\plain\ql \par
\pard\plain\ql     (void)a; \par
\pard\plain\ql     (void)b;\par
\pard\plain\ql \par
\pard\plain\ql     while (iter < HARD_ITER_LIMIT)\par
\pard\plain\ql     \{\par
\pard\plain\ql         double fx = f(x);\par
\pard\plain\ql         double dfx = df(x);\par
\pard\plain\ql \par
\pard\plain\ql         if (fabs(dfx) < 1e-15)\par
\pard\plain\ql         \{\par
\pard\plain\ql             *out_iters = iter;\par
\pard\plain\ql             *out_status = -1;\par
\pard\plain\ql             return x;\par
\pard\plain\ql         \}\par
\pard\plain\ql \par
\pard\plain\ql         iter++;\par
\pard\plain\ql         x_next = x - fx / dfx;\par
\pard\plain\ql \par
\pard\plain\ql         if (fabs(x_next - x) <= eps && fabs(f(x_next)) <= eps)\par
\pard\plain\ql         \{\par
\pard\plain\ql             *out_iters = iter;\par
\pard\plain\ql             *out_status = 1;\par
\pard\plain\ql             return x_next;\par
\pard\plain\ql         \}\par
\pard\plain\ql \par
\pard\plain\ql         x = x_next;\par
\pard\plain\ql \par
\pard\plain\ql         if (!run_to_end && (iter % max_iter == 0))\par
\pard\plain\ql         \{\par
\pard\plain\ql             int action = ask_iteration_limit_action(iter, x, f(x));\par
\pard\plain\ql             if (action == 2)\par
\pard\plain\ql             \{\par
\pard\plain\ql                 run_to_end = 1;\par
\pard\plain\ql             \}\par
\pard\plain\ql             else if (action == 3)\par
\pard\plain\ql             \{\par
\pard\plain\ql                 *out_iters = iter;\par
\pard\plain\ql                 *out_status = 0;\par
\pard\plain\ql                 return x;\par
\pard\plain\ql             \}\par
\pard\plain\ql         \}\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql     *out_iters = iter;\par
\pard\plain\ql     *out_status = -1;\par
\pard\plain\ql     return x;\par
\pard\plain\ql \}\par
