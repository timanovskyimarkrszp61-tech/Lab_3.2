\pard\plain\qc \par
\pard\plain\qc {\b\f1\fs28 \u1041?\u1083?\u1086?\u1082? \u1089?\u1093?\u1077?\u1084?\u1072? \u1092?\u1091?\u1085?\u1082?\u1094?\u1110?\u1111? main \u1088?\u1080?\u1089?. 1}\par
\pard\plain\ql \par
\pard\plain\ql {\b\f1\fs28 4. \u1042?\u1080?\u1093?\u1110?\u1076?\u1085?\u1080?\u1081? \u1082?\u1086?\u1076? \u1087?\u1088?\u1086?\u1075?\u1088?\u1072?\u1084?\u1080?}\par
\pard\plain\ql \par
\pard\plain\ql #include <stdio.h>\par
\pard\plain\ql #include <stdlib.h>\par
\pard\plain\ql #include <math.h>\par
\pard\plain\ql #include <time.h>\par
\pard\plain\ql \par
\pard\plain\ql #define HARD_ITER_LIMIT 1000000 \par
\pard\plain\ql \par
\pard\plain\ql double f(double x);\par
\pard\plain\ql double df(double x);\par
\pard\plain\ql void clear_stdin(void);\par
\pard\plain\ql int check_derivative_monotony(double a, double b);\par
\pard\plain\ql int ask_iteration_limit_action(unsigned long iter, double x_curr, double fx_curr);\par
\pard\plain\ql \par
\pard\plain\ql double solve_bisection(double a, double b, double eps, unsigned long max_iter,\par
\pard\plain\ql                        unsigned long *out_iters, int *out_status);\par
\pard\plain\ql double solve_chord(double a, double b, double eps, unsigned long max_iter,\par
\pard\plain\ql                    unsigned long *out_iters, int *out_status);\par
\pard\plain\ql double solve_newton(double a, double b, double x0, double eps, unsigned long max_iter,\par
\pard\plain\ql                     unsigned long *out_iters, int *out_status);\par
\pard\plain\ql \par
\pard\plain\ql int main(void)\par
\pard\plain\ql \{\par
\pard\plain\ql     int method = 0;                 \par
\pard\plain\ql     double a = 0.0, b = 0.0;       \par
\pard\plain\ql     double x0 = 0.0;               \par
\pard\plain\ql     double eps = 1e-6;              \par
\pard\plain\ql     unsigned long max_iter = 100;   \par
\pard\plain\ql     unsigned long iters = 0;        \par
\pard\plain\ql     int status = 0;                \par
\pard\plain\ql     double root = 0.0;              \par
\pard\plain\ql     clock_t t_start, t_end;        \par
\pard\plain\ql     double elapsed_sec = 0.0;       \par
\pard\plain\ql \par
\pard\plain\ql     printf("============================================================\\n");\par
\pard\plain\ql     printf("  Laboratory Work #3.2 | Solving Nonlinear Equations\\n");\par
\pard\plain\ql     printf("  Variant #5: f(x) = x^3 - 3x^2 - 6x + 8 = 0\\n");\par
\pard\plain\ql     printf("============================================================\\n\\n");\par
\pard\plain\ql \par
\pard\plain\ql \par
\pard\plain\ql     do\par
\pard\plain\ql     \{\par
\pard\plain\ql         printf("Select numerical method:\\n");\par
\pard\plain\ql         printf("  1 - Bisection method (metod polovynnoho dilennia)\\n");\par
\pard\plain\ql         printf("  2 - Chord method (metod khord)\\n");\par
\pard\plain\ql         printf("  3 - Newton's tangent method (metod dotychnykh)\\n");\par
\pard\plain\ql         printf("Your choice (1-3): ");\par
\pard\plain\ql \par
\pard\plain\ql         if (scanf("%d", &method) != 1 || method < 1 || method > 3)\par
\pard\plain\ql         \{\par
\pard\plain\ql             printf("Input error! Please enter 1, 2, or 3.\\n\\n");\par
\pard\plain\ql             clear_stdin();\par
\pard\plain\ql             method = 0;\par
\pard\plain\ql         \}\par
\pard\plain\ql     \} while (method == 0);\par
\pard\plain\ql     clear_stdin();\par
\pard\plain\ql \par
\pard\plain\ql     while (1)\par
\pard\plain\ql     \{\par
\pard\plain\ql         printf("\\nEnter isolation interval boundaries [a, b] (example: 3.2 4.5): ");\par
\pard\plain\ql         if (scanf("%lf %lf", &a, &b) != 2)\par
\pard\plain\ql         \{\par
\pard\plain\ql             printf("Input error! Enter two valid real numbers.\\n");\par
\pard\plain\ql             clear_stdin();\par
\pard\plain\ql             continue;\par
\pard\plain\ql         \}\par
\pard\plain\ql         clear_stdin();\par
\pard\plain\ql \par
\pard\plain\ql         if (a >= b)\par
\pard\plain\ql         \{\par
\pard\plain\ql             printf("Error: Left boundary 'a' must be strictly less than 'b'.\\n");\par
\pard\plain\ql             continue;\par
\pard\plain\ql         \}\par
\pard\plain\ql \par
\pard\plain\ql \par
\pard\plain\ql         if (f(a) * f(b) > 0.0)\par
\pard\plain\ql         \{\par
\pard\plain\ql             printf("Warning: f(a) = %.6lf and f(b) = %.6lf have the same sign!\\n", f(a), f(b));\par
\pard\plain\ql             printf("The interval [%.4lf, %.4lf] may not isolate a single root. Try again.\\n", a, b);\par
\pard\plain\ql             continue;\par
\pard\plain\ql         \}\par
\pard\plain\ql         break;\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql \par
\pard\plain\ql     printf("\\nChecking derivative f'(x) on [%.4lf, %.4lf]:\\n", a, b);\par
\pard\plain\ql     printf("  f'(a) = %.6lf, f'(b) = %.6lf\\n", df(a), df(b));\par
\pard\plain\ql     if (check_derivative_monotony(a, b))\par
\pard\plain\ql     \{\par
\pard\plain\ql         printf("  Result: f'(x) preserves its sign -> function is monotonic (unique root confirmed).\\n");\par
\pard\plain\ql     \}\par
\pard\plain\ql     else\par
\pard\plain\ql     \{\par
\pard\plain\ql         printf("  Warning: f'(x) changes sign on [a, b] -> derivative may vanish inside the interval!\\n");\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql \par
\pard\plain\ql     while (1)\par
\pard\plain\ql     \{\par
\pard\plain\ql         printf("\\nEnter required accuracy eps (e.g., 0.000001): ");\par
\pard\plain\ql         if (scanf("%lf", &eps) != 1 || eps <= 0.0)\par
\pard\plain\ql         \{\par
\pard\plain\ql             printf("Input error! Accuracy eps must be positive.\\n");\par
\pard\plain\ql             clear_stdin();\par
\pard\plain\ql             continue;\par
\pard\plain\ql         \}\par
\pard\plain\ql         clear_stdin();\par
\pard\plain\ql         break;\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql     while (1)\par
\pard\plain\ql     \{\par
\pard\plain\ql         printf("Enter iteration step limit N_max before prompt (e.g., 5 or 100): ");\par
\pard\plain\ql         if (scanf("%lu", &max_iter) != 1 || max_iter == 0)\par
\pard\plain\ql         \{\par
\pard\plain\ql             printf("Input error! N_max must be a positive integer.\\n");\par
\pard\plain\ql             clear_stdin();\par
\pard\plain\ql             continue;\par
\pard\plain\ql         \}\par
\pard\plain\ql         clear_stdin();\par
\pard\plain\ql         break;\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql \par
\pard\plain\ql     if (method == 3)\par
\pard\plain\ql     \{\par
\pard\plain\ql         while (1)\par
\pard\plain\ql         \{\par
\pard\plain\ql             printf("Enter initial guess x0 in [%.4lf, %.4lf] (recommended f(x0)*f''(x0) > 0): ", a, b);\par
\pard\plain\ql             if (scanf("%lf", &x0) != 1 || x0 < a || x0 > b)\par
\pard\plain\ql             \{\par
\pard\plain\ql                 printf("Input error! x0 must lie within [%.4lf, %.4lf].\\n", a, b);\par
\pard\plain\ql                 clear_stdin();\par
\pard\plain\ql                 continue;\par
\pard\plain\ql             \}\par
\pard\plain\ql             clear_stdin();\par
\pard\plain\ql             break;\par
\pard\plain\ql         \}\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql \par
\pard\plain\ql     t_start = clock();\par
\pard\plain\ql \par
\pard\plain\ql     switch (method)\par
\pard\plain\ql     \{\par
\pard\plain\ql         case 1:\par
\pard\plain\ql             root = solve_bisection(a, b, eps, max_iter, &iters, &status);\par
\pard\plain\ql             break;\par
\pard\plain\ql         case 2:\par
\pard\plain\ql             root = solve_chord(a, b, eps, max_iter, &iters, &status);\par
\pard\plain\ql             break;\par
\pard\plain\ql         case 3:\par
\pard\plain\ql             root = solve_newton(a, b, x0, eps, max_iter, &iters, &status);\par
\pard\plain\ql             break;\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql     t_end = clock();\par
\pard\plain\ql     elapsed_sec = (double)(t_end - t_start) / CLOCKS_PER_SEC;\par
\pard\plain\ql \par
\pard\plain\ql \par
\pard\plain\ql     printf("\\n------------------------------------------------------------\\n");\par
\pard\plain\ql     if (status == 1)\par
\pard\plain\ql     \{\par
\pard\plain\ql         printf("Status          : Root found successfully!\\n");\par
\pard\plain\ql     \}\par
\pard\plain\ql     else if (status == 0)\par
\pard\plain\ql     \{\par
\pard\plain\ql         printf("Status          : Stopped by user (intermediate result).\\n");\par
\pard\plain\ql     \}\par
\pard\plain\ql     else\par
\pard\plain\ql     \{\par
\pard\plain\ql         printf("Status          : Calculation error (division by zero or divergence).\\n");\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql     printf("Root value (x)  : %.10lf\\n", root);\par
\pard\plain\ql     printf("Function f(x)   : %.10e\\n", f(root));\par
\pard\plain\ql     printf("Iterations      : %lu\\n", iters);\par
\pard\plain\ql     printf("CPU time        : %.6f sec (%ld clock ticks)\\n",\par
\pard\plain\ql            elapsed_sec, (long)(t_end - t_start));\par
\pard\plain\ql     printf("------------------------------------------------------------\\n");\par
\pard\plain\ql \par
\pard\plain\ql     return 0;\par
\pard\plain\ql \}\par
\pard\plain\ql \par
\pard\plain\ql \par
\pard\plain\ql double f(double x)\par
\pard\plain\ql \{\par
\pard\plain\ql     return x * x * x - 3.0 * x * x - 6.0 * x + 8.0;\par
\pard\plain\ql \}\par
\pard\plain\ql \par
\pard\plain\ql \par
\pard\plain\ql double df(double x)\par
\pard\plain\ql \{\par
\pard\plain\ql     return 3.0 * x * x - 6.0 * x - 6.0;\par
\pard\plain\ql \}\par
\pard\plain\ql \par
\pard\plain\ql \par
\pard\plain\ql void clear_stdin(void)\par
\pard\plain\ql \{\par
\pard\plain\ql     int ch;\par
\pard\plain\ql     while ((ch = getchar()) != '\\n' && ch != EOF)\par
\pard\plain\ql     \{\par
\pard\plain\ql     \}\par
\pard\plain\ql \}\par
\pard\plain\ql \par
\pard\plain\ql \par
\pard\plain\ql int check_derivative_monotony(double a, double b)\par
\pard\plain\ql \{\par
\pard\plain\ql     const int steps = 100;\par
\pard\plain\ql     double h = (b - a) / steps;\par
\pard\plain\ql     double d_first = df(a);\par
\pard\plain\ql \par
\pard\plain\ql     if (fabs(d_first) < 1e-12)\par
\pard\plain\ql     \{\par
\pard\plain\ql         return 0;\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql     for (int i = 1; i <= steps; i++)\par
\pard\plain\ql     \{\par
\pard\plain\ql         double d_curr = df(a + i * h);\par
\pard\plain\ql         if (d_first * d_curr <= 0.0)\par
\pard\plain\ql         \{\par
\pard\plain\ql             return 0;\par
\pard\plain\ql         \}\par
\pard\plain\ql     \}\par
\pard\plain\ql     return 1;\par
\pard\plain\ql \}\par
\pard\plain\ql \par
\pard\plain\ql \par
\pard\plain\ql int ask_iteration_limit_action(unsigned long iter, double x_curr, double fx_curr)\par
\pard\plain\ql \{\par
\pard\plain\ql     int choice = 0;\par
\pard\plain\ql     printf("\\n[!] Reached %lu iterations. Current approximation: x = %.8lf, f(x) = %.4e\\n",\par
\pard\plain\ql            iter, x_curr, fx_curr);\par
\pard\plain\ql     printf("Choose next action:\\n");\par
\pard\plain\ql     printf("  1 (a) - Continue with the same number of iterations\\n");\par
\pard\plain\ql     printf("  2 (b) - Run until the root is found\\n");\par
\pard\plain\ql     printf("  3 (c) - Exit program and display intermediate result\\n");\par
\pard\plain\ql \par
\pard\plain\ql     do\par
\pard\plain\ql     \{\par
\pard\plain\ql         printf("Your choice (1-3): ");\par
\pard\plain\ql         if (scanf("%d", &choice) != 1 || choice < 1 || choice > 3)\par
\pard\plain\ql         \{\par
\pard\plain\ql             printf("Invalid choice! Enter 1, 2, or 3.\\n");\par
\pard\plain\ql             clear_stdin();\par
\pard\plain\ql             choice = 0;\par
\pard\plain\ql         \}\par
\pard\plain\ql     \} while (choice == 0);\par
\pard\plain\ql     clear_stdin();\par
\pard\plain\ql \par
\pard\plain\ql     return choice;\par
\pard\plain\ql \}\par
\pard\plain\ql \par
\pard\plain\ql \par
\pard\plain\ql double solve_bisection(double a, double b, double eps, unsigned long max_iter,\par
\pard\plain\ql                        unsigned long *out_iters, int *out_status)\par
\pard\plain\ql \{\par
\pard\plain\ql     double fa = f(a);\par
\pard\plain\ql     double fb = f(b);\par
\pard\plain\ql     double c = 0.5 * (a + b);\par
\pard\plain\ql     double fc = f(c);\par
\pard\plain\ql     unsigned long iter = 0;\par
\pard\plain\ql     int run_to_end = 0;\par
\pard\plain\ql \par
\pard\plain\ql     if (fabs(fa) <= eps)\par
\pard\plain\ql     \{\par
\pard\plain\ql         *out_iters = 0;\par
\pard\plain\ql         *out_status = 1;\par
\pard\plain\ql         return a;\par
\pard\plain\ql     \}\par
\pard\plain\ql     if (fabs(fb) <= eps)\par
\pard\plain\ql     \{\par
\pard\plain\ql         *out_iters = 0;\par
\pard\plain\ql         *out_status = 1;\par
\pard\plain\ql         return b;\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql     while (fabs(b - a) / 2.0 > eps && iter < HARD_ITER_LIMIT)\par
\pard\plain\ql     \{\par
\pard\plain\ql         iter++;\par
\pard\plain\ql         c = 0.5 * (a + b);\par
\pard\plain\ql         fc = f(c);\par
\pard\plain\ql \par
\pard\plain\ql         if (fabs(fc) <= eps)\par
\pard\plain\ql         \{\par
\pard\plain\ql             *out_iters = iter;\par
\pard\plain\ql             *out_status = 1;\par
\pard\plain\ql             return c;\par
\pard\plain\ql         \}\par
\pard\plain\ql \par
\pard\plain\ql         if (fa * fc < 0.0)\par
\pard\plain\ql         \{\par
\pard\plain\ql             b = c;\par
\pard\plain\ql             fb = fc;\par
\pard\plain\ql         \}\par
\pard\plain\ql         else\par
\pard\plain\ql         \{\par
\pard\plain\ql             a = c;\par
\pard\plain\ql             fa = fc;\par
\pard\plain\ql         \}\par
\pard\plain\ql \par
\pard\plain\ql         if (!run_to_end && (iter % max_iter == 0) && (fabs(b - a) / 2.0 > eps))\par
\pard\plain\ql         \{\par
\pard\plain\ql             int action = ask_iteration_limit_action(iter, 0.5 * (a + b), f(0.5 * (a + b)));\par
\pard\plain\ql             if (action == 2)\par
\pard\plain\ql             \{\par
\pard\plain\ql                 run_to_end = 1;\par
\pard\plain\ql             \}\par
\pard\plain\ql             else if (action == 3)\par
\pard\plain\ql             \{\par
\pard\plain\ql                 *out_iters = iter;\par
\pard\plain\ql                 *out_status = 0;\par
\pard\plain\ql                 return 0.5 * (a + b);\par
\pard\plain\ql             \}\par
\pard\plain\ql         \}\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql     c = 0.5 * (a + b);\par
\pard\plain\ql     *out_iters = iter;\par
\pard\plain\ql     *out_status = 1;\par
\pard\plain\ql     return c;\par
\pard\plain\ql \}\par
\pard\plain\ql \par
\pard\plain\ql \par
\pard\plain\ql double solve_chord(double a, double b, double eps, unsigned long max_iter,\par
\pard\plain\ql                    unsigned long *out_iters, int *out_status)\par
\pard\plain\ql \{\par
\pard\plain\ql     double fa = f(a);\par
\pard\plain\ql     double fb = f(b);\par
\pard\plain\ql     double x = a;\par
\pard\plain\ql     double x_prev = a;\par
\pard\plain\ql     double fx = fa;\par
\pard\plain\ql     unsigned long iter = 0;\par
\pard\plain\ql     int run_to_end = 0;\par
\pard\plain\ql \par
\pard\plain\ql     while (iter < HARD_ITER_LIMIT)\par
\pard\plain\ql     \{\par
\pard\plain\ql         if (fabs(fb - fa) < 1e-15)\par
\pard\plain\ql         \{\par
\pard\plain\ql             *out_iters = iter;\par
\pard\plain\ql             *out_status = -1;\par
\pard\plain\ql             return x;\par
\pard\plain\ql         \}\par
\pard\plain\ql \par
\pard\plain\ql         iter++;\par
\pard\plain\ql         x = a - fa * (b - a) / (fb - fa);\par
\pard\plain\ql         fx = f(x);\par
\pard\plain\ql \par
\pard\plain\ql         if (fabs(fx) <= eps || (iter > 1 && fabs(x - x_prev) <= eps))\par
\pard\plain\ql         \{\par
\pard\plain\ql             *out_iters = iter;\par
\pard\plain\ql             *out_status = 1;\par
\pard\plain\ql             return x;\par
\pard\plain\ql         \}\par
\pard\plain\ql \par
\pard\plain\ql         if (fa * fx < 0.0)\par
\pard\plain\ql         \{\par
\pard\plain\ql             b = x;\par
\pard\plain\ql             fb = fx;\par
\pard\plain\ql         \}\par
\pard\plain\ql         else\par
\pard\plain\ql         \{\par
\pard\plain\ql             a = x;\par
\pard\plain\ql             fa = fx;\par
\pard\plain\ql         \}\par
\pard\plain\ql \par
\pard\plain\ql         x_prev = x;\par
\pard\plain\ql \par
\pard\plain\ql         if (!run_to_end && (iter % max_iter == 0))\par
\pard\plain\ql         \{\par
\pard\plain\ql             int action = ask_iteration_limit_action(iter, x, fx);\par
\pard\plain\ql             if (action == 2)\par
\pard\plain\ql             \{\par
\pard\plain\ql                 run_to_end = 1;\par
\pard\plain\ql             \}\par
\pard\plain\ql             else if (action == 3)\par
